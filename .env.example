PAPERBANANA_SERVER_HOST=localhost
PAPERBANANA_SERVER_PORT=8080
PAPERBANANA_LLM_DEFAULT=gemini
PAPERBANANA_BENCH_ROOT=data/PaperBananaBench

# Encryption key for API keys stored in database
# IMPORTANT: Set a stable secret for production deployments
# If not set, a development key will be generated (NOT SUITABLE FOR PRODUCTION)
PAPERBANANA_ENCRYPTION_KEY=change_me_to_a_stable_secret

# CORS Configuration (comma-separated list of allowed origins)
# For production, set this to your actual frontend domain(s)
# Example: PAPERBANANA_SECURITY_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Default: localhost origins only (safe for development)
# PAPERBANANA_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# API Keys
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# Output settings
PAPERBANANA_OUTPUT_DPI=300
