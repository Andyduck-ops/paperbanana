# PaperBanana Runtime Configuration
#
# Copy this file to config.yaml and fill in your API keys.
# Environment variables (PAPERBANANA_*) can also be used.
#
# To set up:
# 1. Copy .env.example to .env and fill in your API keys
# 2. Or set API keys directly in this file

server:
  host: "0.0.0.0"
  port: 8080

llm:
  default: "linapi"
  providers:
    gemini:
      api_key: "${GEMINI_API_KEY}"
      model: "gemini-2.5-flash"
      timeout: 120s
    linapi:
      api_key: "${LINAPI_API_KEY}"
      base_url: "https://www.linapi.net/v1"
      model: "gemini-3.1-flash-image-preview"
      timeout: 120s
    openai:
      api_key: "${OPENAI_API_KEY}"
      model: "gpt-4o"
      timeout: 120s
    anthropic:
      api_key: "${ANTHROPIC_API_KEY}"
      model: "claude-sonnet-4-20250514"
      timeout: 120s
    openrouter:
      api_key: "${OPENROUTER_API_KEY}"
      base_url: "https://openrouter.ai/api/v1"
      model: "anthropic/claude-sonnet-4"
      timeout: 120s

cache:
  redis:
    enabled: false
    addr: "localhost:6379"
    db: 0

output:
  dpi: 300
  formats:
    - "png"
    - "svg"
    - "pdf"

persistence:
  database_path: ".paperbanana/paperbanana.db"
  enable_foreign_keys: true
  busy_timeout_ms: 5000
  enable_wal: true

assets:
  root: ".paperbanana/assets"
  max_file_size: 104857600  # 100MB

security:
  auth_enabled: false
  rate_limit:
    enabled: true
    requests_per_minute: 60
    burst: 10
  cors:
    allowed_origins:
      - "*"
    allow_credentials: false

plot:
  enabled: false
  sandbox_mode: "none"
