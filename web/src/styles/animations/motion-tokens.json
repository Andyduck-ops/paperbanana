{
  "$schema": "./motion-tokens.schema.json",
  "name": "PaperBanana Motion System",
  "version": "1.0.0",
  "description": "Animation token system for PaperBanana AI academic paper figure generation tool",
  "easing": {
    "ease-out": {
      "value": "cubic-bezier(0.16, 1, 0.3, 1)",
      "use": "exit emphasis, deceleration, content entering view",
      "css_property": "--ease-out"
    },
    "ease-in-out": {
      "value": "cubic-bezier(0.65, 0, 0.35, 1)",
      "use": "smooth symmetrical, state changes, toggles",
      "css_property": "--ease-in-out"
    },
    "ease-spring": {
      "value": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "use": "overshoot bounce, playful interactions, notifications",
      "css_property": "--ease-spring"
    },
    "ease-in": {
      "value": "cubic-bezier(0.4, 0, 1, 1)",
      "use": "progress indicators, compresses perceived wait time",
      "css_property": "--ease-in"
    },
    "ease-out-quart": {
      "value": "cubic-bezier(0.25, 1, 0.5, 1)",
      "use": "smooth deceleration, panel expansions",
      "css_property": "--ease-out-quart"
    }
  },
  "duration": {
    "fast": {
      "value": "0.15s",
      "use": "micro-interactions: button press, toggle, checkbox",
      "css_property": "--duration-fast"
    },
    "base": {
      "value": "0.3s",
      "use": "standard transitions: hover, focus, dropdown",
      "css_property": "--duration-base"
    },
    "slow": {
      "value": "0.6s",
      "use": "content reveals: card entry, panel slide, accordion",
      "css_property": "--duration-slow"
    },
    "slower": {
      "value": "0.8s",
      "use": "page transitions: route change, large element moves",
      "css_property": "--duration-slower"
    },
    "slowest": {
      "value": "1.2s",
      "use": "hero animations: splash screen, onboarding, first load",
      "css_property": "--duration-slowest"
    }
  },
  "stagger": {
    "base_delay": "0s",
    "increment": "0.05s",
    "max_items": 8,
    "css_property": "--stagger-increment"
  },
  "reduced_motion": {
    "duration_override": "0.01ms",
    "easing_override": "linear",
    "allowed": ["opacity"],
    "disallowed": ["parallax", "bounce", "spring", "infinite-loop"],
    "css_property": "--reduced-motion-duration"
  },
  "page_transition": {
    "enter_duration": "0.5s",
    "exit_duration": "0.3s",
    "stagger_children": "0.08s"
  },
  "loading": {
    "skeleton_shimmer_duration": "1.5s",
    "spinner_rotation_duration": "1s",
    "progress_bar_ease": "ease-in"
  },
  "interaction": {
    "button_press_scale": "0.98",
    "button_hover_scale": "1.02",
    "card_hover_lift": "-4px",
    "focus_ring_duration": "0.15s"
  },
  "scroll": {
    "reveal_threshold": 0.2,
    "root_margin": "0px 0px -100px 0px",
    "parallax_foreground_rate": 1.0,
    "parallax_midground_rate": 0.5,
    "parallax_background_rate": 0.2
  }
}
